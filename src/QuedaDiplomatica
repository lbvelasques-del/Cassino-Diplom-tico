import React, { useState } from 'react';

export default function QuedaDiplomatica() {
  const [balance, setBalance] = useState(150000);
  const [bet, setBet] = useState(30000);
  const [multiplier, setMultiplier] = useState(1);
  const [totalWin, setTotalWin] = useState(0);
  const [spinning, setSpinning] = useState(false);
  const [grid, setGrid] = useState([
    ['🦌', '🦌', '🦌', '🦌', '🪙', '💎'],
    ['🛡️', '🦌', '🦌', '💎+1x', '🪙', '🛡️'],
    ['💎+1x', '🛡️', '🪙', '🪙', '🦌', '🦌'],
    ['🪙', '🦌', '🪙', '🪙', '🪙', '🦌'],
    ['💎+1x', '💎', '🪙', '🪙', '💎', '🦌']
  ]);

  const symbols = ['🦌', '🪙', '💎', '🛡️', '💎+1x'];

  const spinDrop = () => {
    if (balance < bet) {
      alert('Saldo insuficiente!');
      return;
    }

    setBalance(prev => prev - bet);
    setSpinning(true);
    setTotalWin(0);
    setMultiplier(1);

    setTimeout(() => {
      const newGrid = Array(5).fill(0).map(() => 
        Array(6).fill(0).map(() => symbols[Math.floor(Math.random() * symbols.length)])
      );
      setGrid(newGrid);

      const winChance = Math.random();
      if (winChance > 0.4) {
        const mults = [1.5, 2.0, 2.5, 3.0, 5.0];
        const selectedMult = mults[Math.floor(Math.random() * mults.length)];
        const winValue = bet * selectedMult;
        setMultiplier(selectedMult);
        setTotalWin(winValue);
        setBalance(prev => prev + winValue);
      }
      setSpinning(false);
    }, 800);
  };

  return (
    <div className="min-h-screen bg-black text-white font-sans antialiased p-4 pb-12 flex flex-col items-center">
      <div className="w-full max-w-md space-y-4 text-center">
        
        {/* Título do Jogo Corrigido */}
        <div className="pt-2">
          <h1 className="text-2xl font-black tracking-widest text-transparent bg-clip-text bg-gradient-to-r from-amber-300 via-yellow-100 to-amber-500">
            QUEDA DIPLOMÁTICA
          </h1>
          <p className="text-[11px] text-zinc-400 font-semibold uppercase tracking-wider mt-1">
            Cascata Progressiva até 5x
          </p>
        </div>

        {/* Caixa de Info de Jogo */}
        <div className="bg-[#141418] border border-zinc-800 rounded-3xl p-4 shadow-xl space-y-3">
          <div className="flex justify-between items-center bg-black/50 p-3 rounded-2xl border border-zinc-900">
            <div>
              <span className="text-[10px] text-zinc-400 block uppercase font-bold">Multiplicador Atual</span>
              <span className="text-amber-400 font-black text-lg">{multiplier}x</span>
            </div>
            <div className="text-right">
              <span className="text-[10px] text-zinc-400 block uppercase font-bold">Ganho Total</span>
              <span className="text-emerald-400 font-black text-lg">R$ {totalWin.toLocaleString('pt-BR')}</span>
            </div>
          </div>

          <div className="text-center py-2 bg-amber-500/10 border border-amber-500/30 rounded-xl">
            <span className="text-xs text-amber-300 font-bold">ENCONTRE 8+ SÍMBOLOS IGUAIS PARA VENCER!</span>
          </div>

          {/* Grelha de Cascata */}
          <div className="grid grid-cols-6 gap-1.5 bg-black p-3 rounded-2xl border border-zinc-900">
            {grid.map((row, rowIndex) =>
              row.map((symbol, colIndex) => (
                <div 
                  key={`${rowIndex}-${colIndex}`} 
                  className="aspect-square bg-zinc-900/80 border border-zinc-800 rounded-xl flex items-center justify-center text-lg shadow-inner transition-all hover:border-amber-500/50"
                >
                  {symbol}
                </div>
              ))
            )}
          </div>
        </div>

        {/* Painel de Controlo de Aposta */}
        <div className="bg-[#141418] border border-zinc-800 rounded-3xl p-4 space-y-3 shadow-xl">
          <div className="flex justify-between items-center text-xs text-zinc-400 font-bold px-1">
            <span>APOSTA</span>
            <span className="text-amber-400">R$ {bet.toLocaleString('pt-BR')}</span>
          </div>

          <button
            onClick={spinDrop}
            disabled={spinning}
            className="w-full bg-gradient-to-r from-amber-500 via-yellow-400 to-amber-500 text-black font-black py-4 rounded-2xl text-sm shadow-lg hover:scale-[1.02] active:scale-95 transition-all disabled:opacity-50"
          >
            {spinning ? 'A GIRAR CASCATA...' : '🌀 GIRAR QUEDA'}
          </button>
        </div>

      </div>
    </div>
  );
}
